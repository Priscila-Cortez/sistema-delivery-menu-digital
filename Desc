<?php
// Limpiar cualquier salida previa o espacio en blanco para que el JSON viaje limpio
ob_clean();
ob_start();

session_start();
include "../../conexion.php";

// Desactivar la visualización directa de errores en pantalla para no corromper el JSON
ini_set('display_errors', 0);
error_reporting(E_ALL);

header('Content-Type: application/json; charset=utf-8');

if ($_SERVER["REQUEST_METHOD"] == "POST") {
    $usu_iId = isset($_SESSION['idUser']) ? (int)$_SESSION['idUser'] : 0;
    $tipoAusencia = $_POST['tipoAusencia'] ?? null;
    $fechaInicio = $_POST['fechaInicio'] ?? null;
    $fechaFin = $_POST['fechaFin'] ?? null;
    $dni = $_POST['dni'] ?? null;
    $subunidad = $_POST['subunidad'] ?? null;
    $conplaId = $_POST['conplaId'] ?? null;
    $cliId = $_POST['cliId'] ?? null;
    $montoDiario = isset($_POST['monto_diario']) && $_POST['monto_diario'] !== '' ? (float)$_POST['monto_diario'] : 0.00;

    $forzarNormal = isset($_POST['forzar_normal']) ? $_POST['forzar_normal'] === '1' : false;

    date_default_timezone_set('America/Lima');
    $fecha_hoy = date("Y-m-d");

    if (!$usu_iId || !$tipoAusencia || !$fechaInicio || !$fechaFin || !$dni || !$conplaId || !$cliId) {
        ob_clean();
        echo json_encode(["error" => "Faltan datos obligatorios."]);
        exit;
    }

    // Buscar platra_iId, conpla_iCodigo y nombre del trabajador
    $consulta01 = "SELECT DISTINCT ptl.platra_iId, cp.conpla_iCodigo, p.per_vcNombres
                   FROM persona p
                   INNER JOIN planilla_trabajadorlog ptl ON ptl.per_iId = p.per_iId
                   INNER JOIN contrato_planilla cp ON cp.conpla_iId = ptl.conpla_iId
                   WHERE p.per_vcDocumento = ? AND cp.conpla_iId = ?";
                   
    $stmt = $conn->prepare($consulta01);
    if (!$stmt) {
        ob_clean();
        echo json_encode(["error" => "Error en BD: " . $conn->error]);
        exit;
    }
    $stmt->bind_param("ss", $dni, $conplaId);
    $stmt->execute();
    $stmt->bind_result($platra_iId, $conpla_iCodigo, $nombreTrabajador);

    if (!$stmt->fetch()) {
        $stmt->close();
        ob_clean();
        echo json_encode(["error" => "No se encontró ningún registro asociado al DNI y contrato."]);
        exit;
    }
    $stmt->close();

    // Procesar archivo adjunto si existe
    $documentoDatos = null;
    $documentoNombre = null;
    $documentoTipo = null;

    if (isset($_FILES["documento"]) && $_FILES["documento"]["error"] == 0) {
        $documentoNombre = $_FILES["documento"]["name"];
        $documentoTipo = $_FILES["documento"]["type"];
        $documentoDatos = file_get_contents($_FILES["documento"]["tmp_name"]);
    }

    // Función auxiliar para insertar absentismo y actualizar tareo/asistencia
    function registrarAbsentismoYTareo($conn, $cliId, $conplaId, $conpla_iCodigo, $tipo, $fInicio, $fFin, $platra_iId, $dni, $docDatos, $docNombre, $docTipo, $usuId, $fHoy, $montoDiario = 0.00) {
        $query = "INSERT INTO planilla_trabajador_absentismosalud 
                  (cli_iId, conpla_iId, conpla_iCodigo, platraabs_conceptoRemunerativo, platraabs_fechaInicio, platraabs_fechaFin, platra_iId, 
                  platraabs_dni, platraabs_documento, platraabs_documentoNombre, platraabs_tipoArchivo, usu_iId, platraabs_fechaInsercion)
                  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";

        $stmt = $conn->prepare($query);
        if (!$stmt) {
            return false;
        }
        
        $stmt->bind_param("sssssssssssis", $cliId, $conplaId, $conpla_iCodigo, $tipo, $fInicio, $fFin, $platra_iId, $dni, $docDatos, $docNombre, $docTipo, $usuId, $fHoy);
        
        if ($stmt->execute()) {
            $stmt->close();

            if ($tipo === 'SUB' || $tipo === 'SUBM') {
                $nombreEmpresa = 'Empresa';
                $queryEmp = "SELECT cli_vcRazonSocial FROM cliente WHERE cli_iId = ?";
                $stmtEmp = $conn->prepare($queryEmp);
                if ($stmtEmp) {
                    $stmtEmp->bind_param("s", $cliId);
                    $stmtEmp->execute();
                    $stmtEmp->bind_result($empEncontrada);
                    if ($stmtEmp->fetch() && !empty($empEncontrada)) {
                        $nombreEmpresa = $empEncontrada;
                    }
                    $stmtEmp->close();
                }

                global $nombreTrabajador;
                $montoDiarioNum = (float)$montoDiario;

                $querySubIns = "INSERT INTO subsidios (empresa, nombre_trabajador, numdocumento, fecha_inicio, fecha_fin, monto_diario) VALUES (?, ?, ?, ?, ?, ?)";
                $stmtSub = $conn->prepare($querySubIns);
                if ($stmtSub) {
                    $stmtSub->bind_param("sssssd", $nombreEmpresa, $nombreTrabajador, $dni, $fInicio, $fFin, $montoDiarioNum);
                    $stmtSub->execute();
                    $stmtSub->close();
                }
            }

            if (in_array($tipo, ['DM', 'SUB', 'SUBM'])) {
                $for_iId_map = ['DM' => 66, 'SUB' => 87, 'SUBM' => 136];
                $for_iId = $for_iId_map[$tipo];

                $inicio = new DateTime($fInicio);
                $fin = new DateTime($fFin);
                $intervalo = new DateInterval('P1D');
                $periodo = new DatePeriod($inicio, $intervalo, $fin->modify('+1 day'));

                $delete2 = "DELETE FROM planilla_trabajador_asistenciatareo WHERE platra_iId = ? AND conpla_iCodigo = ? AND platraast_fecha BETWEEN ? AND ?";
                $stmtDel2 = $conn->prepare($delete2);
                if ($stmtDel2) {
                    $stmtDel2->bind_param("ssss", $platra_iId, $conpla_iCodigo, $fInicio, $fFin);
                    $stmtDel2->execute();
                    $stmtDel2->close();
                }
                
                $queryInsert = "INSERT INTO planilla_trabajador_asistenciatareo (platra_iId, conpla_iCodigo, for_iId, platraast_fecha, platraast_tiempo) VALUES (?, ?, ?, ?, ?)";
                $stmt2 = $conn->prepare($queryInsert);
                if ($stmt2) {
                    foreach ($periodo as $fecha) {
                        $fechaFormato = $fecha->format('Y-m-d');
                        $tiempo = '1';
                        $stmt2->bind_param("sssss", $platra_iId, $conpla_iCodigo, $for_iId, $fechaFormato, $tiempo);
                        $stmt2->execute();
                    }
                    $stmt2->close();
                }

                $delete1 = "DELETE FROM planilla_trabajador_asistencia WHERE platra_iId = ? AND conpla_iCodigo = ? AND platraas_fecha BETWEEN ? AND ?";
                $stmtDel1 = $conn->prepare($delete1);
                if ($stmtDel1) {
                    $stmtDel1->bind_param("ssss", $platra_iId, $conpla_iCodigo, $fInicio, $fFin);
                    $stmtDel1->execute();
                    $stmtDel1->close();
                }
            }
            return true;
        }
        return false;
    }

    // VALIDACIÓN INICIAL Y CÁLCULO DE LOS 20 DÍAS DE DESCANSO MÉDICO
    $anioActual = date('Y', strtotime($fechaInicio));

    $querySuma = "SELECT SUM(DATEDIFF(pta.platraabs_fechaFin, pta.platraabs_fechaInicio) + 1) AS dias_acumulados
                  FROM planilla_trabajador_absentismosalud pta
                  WHERE pta.platraabs_dni = ? 
                    AND YEAR(pta.platraabs_fechaInicio) = ?
                    AND pta.platraabs_conceptoRemunerativo = 'DM'";
    $stmtSuma = $conn->prepare($querySuma);
    $stmtSuma->bind_param("ss", $dni, $anioActual);
    $stmtSuma->execute();
    $stmtSuma->bind_result($diasPrevios);
    $stmtSuma->fetch();
    $stmtSuma->close();

    $diasPrevios = intval($diasPrevios ?? 0);
    $diasRestantesEmpresa = max(0, 20 - $diasPrevios);

    if ($tipoAusencia === 'DM' && !$forzarNormal) {
        $f1 = new DateTime($fechaInicio);
        $f2 = new DateTime($fechaFin);
        $diasNuevos = $f1->diff($f2)->days + 1;

        if ($diasRestantesEmpresa === 0 || $diasNuevos > $diasRestantesEmpresa) {
            ob_clean();
            echo json_encode([
                "limite_alcanzado" => true,
                "nombre" => $nombreTrabajador,
                "dias_restantes" => $diasRestantesEmpresa
            ]);
            exit;
        }

        if ($diasNuevos <= $diasRestantesEmpresa) {
            $diasDisponiblesDespues = $diasRestantesEmpresa - $diasNuevos;
            ob_clean();
            echo json_encode([
                "dias_disponibles" => true,
                "nombre" => $nombreTrabajador,
                "dias_restantes" => $diasDisponiblesDespues
            ]);
            exit;
        }
    }

    // AVISO AL REGISTRAR SUBSIDIO (SUB / SUBM) SI AÚN LE QUEDAN DÍAS DE DESCANSO MÉDICO
    if (in_array($tipoAusencia, ['SUB', 'SUBM']) && !$forzarNormal && $diasRestantesEmpresa > 0) {
        ob_clean();
        echo json_encode([
            "aviso_dm_disponible_subsidio" => true,
            "nombre" => $nombreTrabajador,
            "dias_restantes" => $diasRestantesEmpresa
        ]);
        exit;
    }

    // GUARDADO NORMAL O DIRECTO (Para Subsidios, Maternidad o Descansos forzados bajo el límite)
    if ($forzarNormal || in_array($tipoAusencia, ['SUB', 'SUBM'])) {
        if (registrarAbsentismoYTareo($conn, $cliId, $conplaId, $conpla_iCodigo, $tipoAusencia, $fechaInicio, $fechaFin, $platra_iId, $dni, $documentoDatos, $documentoNombre, $documentoTipo, $usu_iId, $fecha_hoy, $montoDiario)) {
            ob_clean();
            echo json_encode(["mensaje" => "Registro guardado exitosamente."]);
        } else {
            ob_clean();
            echo json_encode(["error" => "Error al guardar los datos en la base de datos."]);
        }
        exit;
    }

    ob_clean();
    echo json_encode(["error" => "Tipo de ausencia no válido o acción no reconocida."]);
    exit;
}






