<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Visualizar documento
    document.getElementById('documento').addEventListener('change', function(event) {
        const file = event.target.files[0];
        const previewContainer = document.getElementById('previewContainer');
        const previewImage = document.getElementById('previewImage');
        const previewPdf = document.getElementById('previewPdf');

        if (file) {
            const fileType = file.type;
            previewContainer.style.display = 'block';

            if (fileType.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImage.src = e.target.result;
                    previewImage.style.display = 'block';
                    previewPdf.style.display = 'none';
                };
                reader.readAsDataURL(file);
            } else if (fileType === 'application/pdf') {
                const fileURL = URL.createObjectURL(file);
                previewPdf.src = fileURL;
                previewPdf.style.display = 'block';
                previewImage.style.display = 'none';
            } else {
                previewContainer.style.display = 'none';
            }
        } else {
            previewContainer.style.display = 'none';
        }
    });

    // Verificar Persona por DNI
    $(document).ready(function() {
        $("#dni").on("keyup", function() {
            let dni = $(this).val();

            if (dni.length >= 8) {
                $.ajax({
                    url: "procedimientos/descansoMedico_validarDNI.php",
                    type: "POST",
                    data: { dni: dni },
                    dataType: "json",
                    success: function(response) {
                        if (response.success) {
                            $("#errorDNI").hide();
                            $("#exitoDNI").show();

                            if (response.empresas.length === 1) {
                                $("#subunidad").val(response.empresas[0].nombre);
                                $("#conplaId").val(response.empresas[0].conpla_id);
                                $("#cliId").val(response.empresas[0].cli_id);
                            } else {
                                $("#listaEmpresas").empty();
                                response.empresas.forEach(function(empresa) {
                                    $("#listaEmpresas").append(
                                        `<li class="list-group-item list-group-item-action empresa-item" 
                                        data-id="${empresa.cli_id}" 
                                        data-conpla="${empresa.conpla_id}">
                                        ${empresa.nombre}
                                    </li>`
                                    );
                                });
                                $("#modalEmpresas").modal("show");
                            }
                        } else {
                            $("#exitoDNI").hide();
                            $("#errorDNI").text("⚠ DNI no encontrado en la base de datos").show();
                            $("#subunidad").val("");
                            $("#conplaId").val("");
                            $("#cliId").val("");
                        }
                    },
                    error: function() {
                        alert("Error en la consulta AJAX de DNI");
                    }
                });
            }
        });

        $(document).on("click", ".empresa-item", function() {
            let empresaNombre = $(this).text();
            let empresaId = $(this).data("id");
            let conplaId = $(this).data("conpla");

            $("#subunidad").val(empresaNombre);
            $("#cliId").val(empresaId);
            $("#conplaId").val(conplaId);
            $("#modalEmpresas").modal("hide");
        });
    });

    // Guardar Documento con Control Total de Modales
    $(document).ready(function() {
        $(document).off("submit", "#form1").on("submit", "#form1", function(e) {
            e.preventDefault();

            let fechaInicio = $("#fechaInicio").val();
            let fechaFin = $("#fechaFin").val();

            if (fechaInicio === "0000-00-00" || fechaFin === "0000-00-00") {
                alert("⚠ No se permite la fecha 0000-00-00");
                return;
            }

            var formData = new FormData(this);

            $.ajax({
                url: "procedimientos/descansoMedico_guardar.php",
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                dataType: "json",
                success: function(response) {
                    if (response.dias_disponibles) {
                        // Muestra el Modal de Días Disponibles
                        $("#nombreTrabajadorDisp").text(response.nombre);
                        $("#diasRestantesDisp").text(response.dias_restantes);
                        
                        var modalDisp = new bootstrap.Modal(document.getElementById('modalDiasDisponibles'));
                        modalDisp.show();

                        $("#btnContinuarDescansoNormal").off("click").on("click", function() {
                            formData.append("forzar_normal", "1");
                            modalDisp.hide();
                            enviarDatosServidorFinal(formData);
                        });

                    } else if (response.aviso_dm_disponible_subsidio) {
                        // Muestra aviso si se intenta registrar Subsidio y aún le quedan días de Descanso Médico
                        $("#nombreTrabajadorSubDm").text(response.nombre);
                        $("#diasRestantesSubDm").text(response.dias_restantes);

                        var modalSubDm = new bootstrap.Modal(document.getElementById('modalSubsidioConDmDisponible'));
                        modalSubDm.show();

                        $("#btnContinuarSubsidioConDm").off("click").on("click", function() {
                            formData.append("forzar_normal", "1");
                            modalSubDm.hide();
                            enviarDatosServidorFinal(formData);
                        });

                    } else if (response.limite_alcanzado) {
                        // Muestra el Modal de Límite Alcanzado (Solo informativo, cierra al aceptar)
                        $("#nombreTrabajadorLimit").text(response.nombre);
                        $("#diasRestantesLimit").text(response.dias_restantes);
                        
                        var modalLimit = new bootstrap.Modal(document.getElementById('modalLimiteAlcanzado'));
                        modalLimit.show();

                    } else if (response.existe) {
                        $("#modalConfirmar #rangoFechas").text(response.fechaInicio + " al " + response.fechaFin);
                        $("#modalConfirmar #tipoAusenciaActual").text(response.tipoAusencia);
                        $("#modalConfirmar").modal("show");

                        $("#btnReemplazar").off("click").on("click", function() {
                            var updateData = new FormData(document.getElementById('form1'));
                            updateData.append("actualizar", true);
                            $.ajax({
                                url: "procedimientos/descansoMedico_actualizar.php",
                                type: "POST",
                                data: updateData,
                                contentType: false,
                                processData: false,
                                success: function(updateResponse) {
                                    alert(updateResponse);
                                    location.reload();
                                },
                                error: function() {
                                    alert("Error al actualizar el registro.");
                                }
                            });
                        });
                    } else if (response.mensaje) {
                        alert(response.mensaje);
                        location.reload();
                    } else if (response.error) {
                        alert("⚠ " + response.error);
                    }
                },
                error: function(xhr) {
                    console.error(xhr.responseText);
                    alert("Error al procesar la solicitud en el servidor.");
                }
            });
        });

        function enviarDatosServidorFinal(formData) {
            $.ajax({
                url: "procedimientos/descansoMedico_guardar.php",
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                dataType: "json",
                success: function(res) {
                    alert(res.mensaje || "¡Operación realizada con éxito!");
                    location.reload();
                },
                error: function() {
                    alert("Error al registrar de forma definitiva.");
                }
            });
        }
    });
</script>

<script>
    // Función para calcular los días dinámicamente entre las fechas seleccionadas
    function calcularTotalDias() {
        let fInicio = $("#fechaInicio").val();
        let fFin = $("#fechaFin").val();

        if (fInicio && fFin) {
            let fecha1 = new Date(fInicio);
            let fecha2 = new Date(fFin);

            // Validar que la fecha de fin no sea menor a la de inicio
            if (fecha2 >= fecha1) {
                // Diferencia en milisegundos convertida a días + 1 (para incluir el primer día)
                let diferenciaTiempo = fecha2 - fecha1;
                let diasTotales = (diferenciaTiempo / (1000 * 60 * 60 * 24)) + 1;
                $("#totalDiasCalculados").val(diasTotales);
            } else {
                $("#totalDiasCalculados").val(0);
            }
        } else {
            $("#totalDiasCalculados").val(0);
        }
    }

    // Escuchar cambios en los inputs de fecha
    $("#fechaInicio, #fechaFin").on("change", function() {
        calcularTotalDias();
    });
</script>

