<!-- Selección de Tipo de Ausencia y Fechas con cálculo en línea -->
<div class="form-group row mt-3 align-items-center">
    <label class="col-md-2 col-form-label text-right">Absentismo por salud:</label>
    <div class="col-md-2">
        <select class="form-control" id="tipoAusencia" name="tipoAusencia" required>
            <option value="" selected disabled>Seleccionar...</option>
            <option value="DM">Descanso Médico</option>
            <option value="SUB">Subsidio por Incapacidad</option>
            <option value="SUBM">Subsidio por Maternidad</option>
        </select>
    </div>

    <label class="col-md-1 col-form-label text-right">F. Inicio:</label>
    <div class="col-md-2">
        <input type="date" class="form-control" id="fechaInicio" name="fechaInicio" min="2010-01-01" required>
    </div>

    <label class="col-md-1 col-form-label text-right">F. Fin:</label>
    <div class="col-md-2">
        <input type="date" class="form-control" id="fechaFin" name="fechaFin" min="2010-01-01" required>
    </div>

    <!-- Indicador visual del total de días en tiempo real (Sin modales) -->
    <div class="col-md-2 text-center">
        <span class="badge bg-primary px-3 py-2 fs-6 w-100 shadow-sm" style="font-weight: 600;">
            Total: <span id="textoTotalDias">0</span> días
        </span>
        <!-- Input oculto por si necesitas enviarlo por POST al guardar -->
        <input type="hidden" id="inputTotalDiasOculto" name="total_dias_calculado" value="0">
    </div>
</div>



<script>
    // Función para calcular los días en tiempo real
    function calcularDiasEnLinea() {
        let fInicio = $("#fechaInicio").val();
        let fFin = $("#fechaFin").val();

        if (fInicio && fFin) {
            let fecha1 = new Date(fInicio);
            let fecha2 = new Date(fFin);

            // Validar que la fecha de fin no sea anterior a la de inicio
            if (fecha2 >= fecha1) {
                let diferenciaTiempo = fecha2 - fecha1;
                // Se suma 1 para incluir el día de inicio
                let diasTotales = (diferenciaTiempo / (1000 * 60 * 60 * 24)) + 1;
                
                $("#textoTotalDias").text(diasTotales);
                $("#inputTotalDiasOculto").val(diasTotales);
            } else {
                $("#textoTotalDias").text("0");
                $("#inputTotalDiasOculto").val("0");
            }
        } else {
            $("#textoTotalDias").text("0");
            $("#inputTotalDiasOculto").val("0");
        }
    }

    // Escuchar cuando el usuario cambie cualquiera de las dos fechas
    $("#fechaInicio, #fechaFin").on("change", function() {
        calcularDiasEnLinea();
    });
</script>





