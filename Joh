                                error: function() {
                                    alert("Error al actualizar el registro.");
                                }
                            });
                        });
                    } else if (response.mensaje) {
                        alert(response.mensaje);
                        location.reload();
                    } else if (response.error) {
                        alert("⚠ " + response.error);
                    }
                },
                error: function(xhr) {
                    console.error(xhr.responseText);
                    alert("Error al procesar la solicitud en el servidor.");
                }
            });
        });

        function enviarDatosServidorFinal(formData) {
            $.ajax({
                url: "procedimientos/descansoMedico_guardar.php",
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                dataType: "json",
                success: function(res) {
                    alert(res.mensaje || "¡Operación realizada con éxito!");
                    location.reload();
                },
                error: function() {
                    alert("Error al registrar de forma definitiva.");
                }
            });
        }
    });
</script>




