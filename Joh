<script>
    // Visualizar documento
    document.getElementById('documento').addEventListener('change', function(event) {
        const file = event.target.files[0];
        const previewContainer = document.getElementById('previewContainer');
        const previewImage = document.getElementById('previewImage');
        const previewPdf = document.getElementById('previewPdf');

        if (file) {
            const fileType = file.type;
            previewContainer.style.display = 'block';

            if (fileType.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImage.src = e.target.result;
                    previewImage.style.display = 'block';
                    previewPdf.style.display = 'none';
                };
                reader.readAsDataURL(file);
            } else if (fileType === 'application/pdf') {
                const fileURL = URL.createObjectURL(file);
                previewPdf.src = fileURL;
                previewPdf.style.display = 'block';
                previewImage.style.display = 'none';
            } else {
                previewContainer.style.display = 'none';
            }
        } else {
            previewContainer.style.display = 'none';
        }
    });

    // Función para calcular los días dinámicamente entre las fechas seleccionadas
    function calcularTotalDias() {
        let fInicio = $("#fechaInicio").val();
        let fFin = $("#fechaFin").val();

        if (fInicio && fFin) {
            let fecha1 = new Date(fInicio);
            let fecha2 = new Date(fFin);

            if (fecha2 >= fecha1) {
                let diferenciaTiempo = fecha2 - fecha1;
                let diasTotales = (diferenciaTiempo / (1000 * 60 * 60 * 24)) + 1;
                $("#totalDiasCalculados").val(diasTotales);
            } else {
                $("#totalDiasCalculados").val(0);
            }
        } else {
            $("#totalDiasCalculados").val(0);
        }
    }

    $("#fechaInicio, #fechaFin").on("change", function() {
        calcularTotalDias();
    });

    // Verificar Persona por DNI
    $(document).ready(function() {
        $("#dni").on("keyup", function() {
            let dni = $(this).val();

            if (dni.length >= 8) {
                $.ajax({
                    url: "procedimientos/descansoMedico_validarDNI.php",
                    type: "POST",
                    data: { dni: dni },
                    dataType: "json",
                    success: function(response) {
                        if (response.success) {
                            $("#errorDNI").hide();
                            $("#exitoDNI").show();

                            if (response.empresas.length === 1) {
                                $("#subunidad").val(response.empresas[0].nombre);
                                $("#conplaId").val(response.empresas[0].conpla_id);
                                $("#cliId").val(response.empresas[0].cli_id);
                            } else {
                                $("#listaEmpresas").empty();
                                response.empresas.forEach(function(empresa) {
                                    $("#listaEmpresas").append(
                                        `<li class="list-group-item list-group-item-action empresa-item" 
                                        data-id="${empresa.cli_id}" 
                                        data-conpla="${empresa.conpla_id}">
                                        ${empresa.nombre}
                                    </li>`
                                    );
                                });
                                $("#modalEmpresas").modal("show");
                            }
                        } else {
                            $("#exitoDNI").hide();
                            $("#errorDNI").text("⚠ DNI no encontrado en la base de datos").show();
                            $("#subunidad").val("");
                            $("#conplaId").val("");
                            $("#cliId").val("");
