                    error: function() {
                        alert("Error en la consulta AJAX de DNI");
                    }
                });
            }
        });

        $(document).on("click", ".empresa-item", function() {
            let empresaNombre = $(this).text();
            let empresaId = $(this).data("id");
            let conplaId = $(this).data("conpla");

            $("#subunidad").val(empresaNombre);
            $("#cliId").val(empresaId);
            $("#conplaId").val(conplaId);
            $("#modalEmpresas").modal("hide");
        });
    });

    // Guardar Documento con Control Total de Modales
    $(document).ready(function() {
        $(document).off("submit", "#form1").on("submit", "#form1", function(e) {
            e.preventDefault();

            let fechaInicio = $("#fechaInicio").val();
            let fechaFin = $("#fechaFin").val();

            if (fechaInicio === "0000-00-00" || fechaFin === "0000-00-00") {
                alert("⚠ No se permite la fecha 0000-00-00");
                return;
            }

            var formData = new FormData(this);

            $.ajax({
                url: "procedimientos/descansoMedico_guardar.php",
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                dataType: "json",
                success: function(response) {
                    if (response.dias_disponibles) {
                        $("#nombreTrabajadorDisp").text(response.nombre);
                        $("#diasRestantesDisp").text(response.dias_restantes);
                        
                        var modalDisp = new bootstrap.Modal(document.getElementById('modalDiasDisponibles'));
