<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function() {
        var table = $('#tablaInventario').DataTable({
            "paging": true,
            "pageLength": 5,
            "lengthChange": false,
            "ordering": false,
            "info": false,
            "searching": true,
            "language": {
                "paginate": { "previous": "Anterior", "next": "Siguiente" },
                "info": "Mostrando _START_ a _END_ de _TOTAL_ registros",
                "search": "Buscar:",
                "zeroRecords": "No se encontraron registros"
            }
        });

        // Función para actualizar visualmente la línea de tiempo de una fila sin dejar saltar pasos
        function actualizarTimelineFila(idSubs, nuevoIndice, marcarTodoCompletado = false) {
            var $timeline = $('.timeline-steps[data-id="' + idSubs + '"]');
            $timeline.attr('data-indice-actual', nuevoIndice);

            $timeline.find('button.timeline-step').each(function() {
                var idx = parseInt($(this).data('index'));
                $(this).attr('data-actual', nuevoIndice);
                $(this).removeClass('completed active locked-step');

                if (marcarTodoCompletado || idx < nuevoIndice) {
                    $(this).addClass('completed').prop('disabled', false);
                    $(this).find('.circle').html('<i class="bi bi-check-lg"></i>');
                } else if (idx === nuevoIndice) {
                    $(this).addClass('active').prop('disabled', false);
                    $(this).find('.circle').html('<i class="bi bi-dot"></i>');
                } else {
                    $(this).addClass('locked-step').prop('disabled', true);
                    $(this).find('.circle').text(idx + 1);
                }
            });
        }

        // Control de clic secuencial: solo abre si el paso es el actual o uno ya completado
        $('#tablaInventario').on('click', 'button.timeline-step', function() {
            var indexPaso = parseInt($(this).data('index'));
            var indiceActual = parseInt($(this).closest('.timeline-steps').attr('data-indice-actual'));

            if (indexPaso > indiceActual || $(this).prop('disabled')) {
                return false; // Bloquea el avance si no se han completado los pasos previos
            }

            var targetModalSelector = $(this).data('target-modal');
            var idSubs = $(this).data('id-subs');
            var modalEl = document.querySelector(targetModalSelector);

            if (modalEl) {
                // Cargar el id_subs en el modal correspondiente
                $(modalEl).attr('data-id-subs', idSubs);
                $('#tramite_id_subs, #obs_id_subs, #subsanar_id_subs, #pago_id_subs, #conciliacion_id_subs').val(idSubs);

                var bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                bsModal.show();
            }
        });

        // 2° Paso: En trámite -> Valida campos obligatorios y habilita 3° Observado
        $('#formEnTramite').on('submit', function(e) {
            e.preventDefault();
            var idSubs = $('#tramite_id_subs').val();
            bootstrap.Modal.getInstance(document.getElementById('modalEnTramite')).hide();
            actualizarTimelineFila(idSubs, 2); // Habilita el índice 2 (Observado)
        });

        // 3° Paso: Observado -> Si presiona NO, pasa directo al 4° Registro de pago (índice 3)
        $('#btnObsNo').on('click', function() {
            var idSubs = $('#obs_id_subs').val();
            bootstrap.Modal.getInstance(document.getElementById('exampleModalToggle')).hide();
            actualizarTimelineFila(idSubs, 3); // Habilita el índice 3 (Registro de pago)
        });

        // 3° Paso: Observado -> Si presiona SÍ y subsana, vuelve a 2° En trámite (índice 1)
        $('#formSubsanar').on('submit', function(e) {
            e.preventDefault();
            var idSubs = $('#subsanar_id_subs').val();
            bootstrap.Modal.getInstance(document.getElementById('exampleModalToggle2')).hide();
            actualizarTimelineFila(idSubs, 1); // Vuelve al índice 1 (En trámite)
        });

        // 4° Paso: Registro de pago -> Valida monto y voucher y habilita 5° Conciliación (índice 4)
        $('#formRegistroPago').on('submit', function(e) {
            e.preventDefault();
            var idSubs = $('#pago_id_subs').val();
            bootstrap.Modal.getInstance(document.getElementById('modalRegistroPago')).hide();
            actualizarTimelineFila(idSubs, 4); // Habilita el índice 4 (Conciliación)
        });

        // 5° Paso: Conciliación -> Al confirmar "Realizado", marca todo el flujo como completado
        $('#btnContinuarConciliacion').on('click', function() {
            var idSubs = $('#conciliacion_id_subs').val();
            bootstrap.Modal.getInstance(document.getElementById('modalConciliacion')).hide();
            actualizarTimelineFila(idSubs, 4, true);
        });

        const clienteSelect = $('#cliente');
        const trabajadorSelect = $('#trabajador');

        clienteSelect.on('change', function() {
            var val = $(this).val();
            if (val !== "") { 
                trabajadorSelect.val("").prop('disabled', true); 
            } else { 
                trabajadorSelect.prop('disabled', false); 
            }
            table.column(0).search(val === "all" || val === "" ? "" : $("option:selected", this).text()).draw();
        });

        trabajadorSelect.on('change', function() {
            var val = $(this).val();
            if (val !== "") { 
                clienteSelect.val("").prop('disabled', true); 
            } else { 
                clienteSelect.prop('disabled', false); 
            }
            table.column(1).search(val === "" ? "" : $("option:selected", this).text()).draw();
        });

        $('#resetFiltro').on('click', function() {
            $('#filtroForm')[0].reset();
            clienteSelect.prop('disabled', false);
            trabajadorSelect.prop('disabled', false);
            table.search('').columns().search('').draw();
        });
    });
</script>
</body>
</html>




