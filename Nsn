                    <?php
                    $query = "SELECT 
                                    s.id_subs,
                                    s.empresa,
                                    s.nombre_trabajador,
                                    s.numdocumento,
                                    s.fecha_inicio,
                                    s.fecha_fin,
                                    s.cliente,
                                    totales.total_dias_trabajador AS total_dias
                              FROM subsidios s
                              INNER JOIN (
                                  SELECT 
                                      numdocumento,
                                      SUM(DATEDIFF(fecha_fin, fecha_inicio) + 1) AS total_dias_trabajador
                                  FROM subsidios
                                  GROUP BY numdocumento
                              ) totales ON s.numdocumento = totales.numdocumento
                              ORDER BY s.id_subs DESC";
                    
                    $query_run = @mysqli_query($conn, $query);

