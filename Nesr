                    <?php
                    // Consulta unificada con tu estructura de contratos, matrices y el cálculo de totales de subsidios
                    $query = "SELECT 
                                    s.id_subs,
                                    s.empresa,
                                    s.nombre_trabajador,
                                    s.numdocumento,
                                    s.fecha_inicio,
                                    s.fecha_fin,
                                    s.cliente,
                                    cl.cli_vcRazonSocial AS matriz_razon,
                                    cli.cli_vcRazonSocial AS cliente_contrato,
                                    totales.total_dias_trabajador AS total_dias
                              FROM subsidios s
                              INNER JOIN (
                                  SELECT 
                                      numdocumento,
                                      SUM(DATEDIFF(fecha_fin, fecha_inicio) + 1) AS total_dias_trabajador
                                  FROM subsidios
                                  GROUP BY numdocumento
                              ) totales ON s.numdocumento = totales.numdocumento
                              LEFT JOIN cliente AS cli ON cli.cli_vcRazonSocial = s.cliente
                              LEFT JOIN contrato AS c ON c.cli_iId = cli.cli_iId
                              LEFT JOIN contrato_empresa AS cem ON cem.con_iId = c.con_iId
                              LEFT JOIN cliente AS cl ON cl.cli_iId = cem.cli_iId
                              ORDER BY s.id_subs DESC";
                    
                    $query_run = @mysqli_query($conn, $query);

                    if ($query_run && mysqli_num_rows($query_run) > 0) {
