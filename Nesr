<script>
    $(document).ready(function() {
        var table = $('#tablaInventario').DataTable({
            "paging": true,
            "pageLength": 10,
            "lengthChange": false,
            "ordering": false,
            "info": false,
            "searching": true,
            "language": {
                "paginate": { "previous": "Anterior", "next": "Siguiente" },
                "info": "Mostrando _START_ a _END_ de _TOTAL_ registros",
                "search": "Buscar:",
                "zeroRecords": "No se encontraron registros"
            }
        });

        $('#tablaInventario').on('click', '.btnSubilModal', function() {
            var idSubs = $(this).data('id');
            var totalDias = $(this).data('totaldias');
            $('#modalIdSubs').val(idSubs);
            $('#modalEmpresa').val($(this).data('empresa'));
            $('#modalNombre').val($(this).data('nombre'));
            $('#modalDocumento').val($(this).data('documento'));
            $('#modalTotalDias').val(totalDias);
            $('#txtTotalDias').val(totalDias + " días de subsidio");
        });

        const clienteSelect = $('#cliente');
        const trabajadorSelect = $('#trabajador');

        clienteSelect.on('change', function() {
            var val = $(this).val();
            if (val !== "") { 
                trabajadorSelect.val("").prop('disabled', true); 
            } else { 
                trabajadorSelect.prop('disabled', false); 
            }
            table.column(0).search(val === "all" || val === "" ? "" : $("option:selected", this).text()).draw();
        });

        trabajadorSelect.on('change', function() {
            var val = $(this).val();
            if/val !== ""/ { 
                clienteSelect.val("").prop('disabled', true); 
            } else { 
                clienteSelect.prop('disabled', false); 
            }
            // Ajustado a la columna del trabajador (columna 2 considerando la nueva columna de matriz)
            table.column(2).search(val === "" ? "" : $("option:selected", this).text()).draw();
        });

        $('#resetFiltro').on('click', function() {
            $('#filtroForm')[0].reset();
            clienteSelect.prop('disabled', false);
            trabajadorSelect.prop('disabled', false);
            table.search('').columns().search('').draw();
        });
    });
</script>
