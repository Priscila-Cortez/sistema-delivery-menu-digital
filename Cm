<script>
    $(document).ready(function() {
        var table = $('#tablaInventario').DataTable({
            "paging": false,
            "pageLength": 10,
            "lengthChange": false,
            "ordering": false,
            "info": false,
            "searching": true,
            "language": {
                "paginate": { "previous": "Anterior", "next": "Siguiente" },
                "info": "Mostrando _START_ a _END_ de _TOTAL_ registros",
                "search": "Buscar:",
                "zeroRecords": "No se encontraron registros"
            }
        });

        $('#searchInput').on('keyup', function() {
            table.search(this.value).draw();
        });

        const matrizSelect = $('#matriz');
        const clienteSelect = $('#cliente');

        matrizSelect.on('change', function() {
            var val = $(this).val();
            if (val !== "") {
                clienteSelect.val("").prop('disabled', true);
            } else {
                clienteSelect.prop('disabled', false);
            }
            table.column(0).search(val === "all" || val === "" ? "" : $("option:selected", this).text()).draw();
        });

        clienteSelect.on('change', function() {
            var val = $(this).val();
            if (val !== "") {
                matrizSelect.val("").prop('disabled', true);
            } else {
                matrizSelect.prop('disabled', false);
            }
            table.column(1).search(val === "" ? "" : $("option:selected", this).text()).draw();
        });

        $('#resetFiltro').on('click', function() {
            $('#filtroForm')[0].reset();
            matrizSelect.prop('disabled', false);
            clienteSelect.prop('disabled', false);
            table.search('').columns().search('').draw();
        });
    });
</script>
</body>
</html>
