    $chk = $conn->prepare("SELECT id FROM sub_reporte WHERE id_subs = ? LIMIT 1");
    if (!$chk) {
        return false;
    }
    $chk->bind_param("i", $idSubs);
    $chk->execute();
    $chk->store_result();
    $existe = $chk->num_rows > 0;
    $chk->close();

    if ($existe) {
        $sql = "UPDATE sub_reporte SET
                    empresa = COALESCE(NULLIF(?, ''), empresa),
                    cliente = COALESCE(NULLIF(?, ''), cliente),
                    nombres = COALESCE(NULLIF(?, ''), nombres),
                    DNI = COALESCE(NULLIF(?, ''), DNI),
                    estado = ?,
                    total_dias = ?,
                    monto_diario = COALESCE(?, monto_diario),
                    monto_total_esperado = COALESCE(?, monto_total_esperado),
                    fecha_presentacion = COALESCE(?, fecha_presentacion),
                    n_expediente = COALESCE(?, n_expediente),
                    fecha_cobro = COALESCE(?, fecha_cobro),
                    archivo_expediente = COALESCE(?, archivo_expediente),
                    tiene_observacion = COALESCE(?, tiene_observacion),
                    dias_subsanacion = COALESCE(?, dias_subsanacion),
                    motivo_observacion = COALESCE(?, motivo_observacion),
                    fecha_limite_subsanacion = COALESCE(?, fecha_limite_subsanacion),
                    archivo_observacion = COALESCE(?, archivo_observacion),
                    monto_pagado = COALESCE(?, monto_pagado),
                    archivo_voucher = COALESCE(?, archivo_voucher),
                    confirmado_tesoreria = CASE WHEN ? = 'SI' THEN 'SI' ELSE confirmado_tesoreria END
                WHERE id_subs = ?";

        $stmt = $conn->prepare($sql);
        if (!$stmt) {
            return false;
        }
        $stmt->bind_param(
            "sssssiddsssssississdsi",
            $empresa,
            $cliente,
            $nombres,
            $dni,
            $estado,
            $totalDias,
            $montoDiario,
            $montoTotalEsperado,
            $fechaPresentacion,
            $nExpediente,
            $fechaCobro,
            $archivoExpediente,
            $tieneObservacion,
            $diasSubsanacion,
            $motivoObservacion,
            $fechaLimiteSubsanacion,
            $archivoObservacion,
            $montoPagado,
            $archivoVoucher,
            $confirmadoTesoreria,
            $idSubs
        );
        $ok = $stmt->execute();
        $stmt->close();
        return $ok;
    } else {
        $sql = "INSERT INTO sub_reporte
                    (id_subs, empresa, cliente, nombres, DNI, estado, total_dias, monto_diario, monto_total_esperado,
                     fecha_presentacion, n_expediente, fecha_cobro, archivo_expediente,
                     tiene_observacion, dias_subsanacion, motivo_observacion, fecha_limite_subsanacion, archivo_observacion,
                     monto_pagado, archivo_voucher, confirmado_tesoreria)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";

        $stmt = $conn->prepare($sql);
        if (!$stmt) {
            return false;
        }
        $stmt->bind_param(
            "isssssiddsssssissdsss",
            $idSubs,
            $empresa,
            $cliente,
            $nombres,
            $dni,
            $estado,
            $totalDias,
            $montoDiario,
