<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function() {
        let subsidioActivo = {
            idSubs: null,
            indexActual: 0,
            esActualizacionEnTramite: false
        };

        const modalEnTramiteEl = document.querySelector('#modalEnTramite');
        const $formEnTramite = $('#formEnTramite');
        const $inputFechaPresentacion = $formEnTramite.find('input[name="fechaPresentacion"]');
        const $inputNumExpediente = $formEnTramite.find('input[name="numExpediente"]');
        const $inputFechaCobro = $formEnTramite.find('input[name="fechaCobro"]');
        const $inputArchivoTramite = $formEnTramite.find('input[name="archivo"]');

        function configurarModalEnTramite(soloFechaCobro) {
            $formEnTramite[0].reset();

            if (soloFechaCobro) {
                $inputFechaPresentacion.prop('disabled', true).prop('required', false);
                $inputNumExpediente.prop('disabled', true).prop('required', false);
                $inputArchivoTramite.prop('disabled', true).prop('required', false);
                $inputFechaCobro.prop('disabled', false).prop('readonly', false).prop('required', true);
            } else {
                $inputFechaPresentacion.prop('disabled', false).prop('required', true);
                $inputNumExpediente.prop('disabled', false).prop('required', true);
                $inputArchivoTramite.prop('disabled', false).prop('required', false);
                $inputFechaCobro.prop('disabled', false).prop('readonly', false).prop('required', false);
            }
        }

        if (modalEnTramiteEl) {
            modalEnTramiteEl.addEventListener('hidden.bs.modal', function() {
                configurarModalEnTramite(false);
                subsidioActivo.esActualizacionEnTramite = false;
            });
        }

        var table = $('#tablaInventario').DataTable({
            "paging": true,
            "pageLength": 10,
            "lengthChange": false,
            "ordering": false,
            "info": false,
            "searching": true,
            "language": {
                "paginate": { "previous": "Anterior", "next": "Siguiente" },
                "info": "Mostrando _START_ a _END_ de _TOTAL_ registros",
                "search": "Buscar:",
                "zeroRecords": "No se encontraron registros"
            }
        });

        function asignarIdSubsModales(idSubs) {
            $('.input-id-subs').val(idSubs);
            $('.modal').attr('data-id-subs', idSubs);
        }

        function enviarActualizacionEstado(idSubs, nuevoEstado, mensajeConfirmacion = null, payloadExtra = null) {
            if (!idSubs) {
                alert('No se identificó el subsidio seleccionado.');
                return;
            }

            if (mensajeConfirmacion && !confirm(mensajeConfirmacion)) {
                return;
            }

            const formData = payloadExtra instanceof FormData ? payloadExtra : new FormData();
            formData.set('id_subs', idSubs);
            formData.set('nuevo_estado', nuevoEstado);

            fetch('procedimientos/subsidios_controller.php', {
                method: 'POST',
                body: formData
            })
            .then(async response => {
                if (response.ok) {
                    window.location.reload();
                } else {
                    const errorTexto = await response.text();
                    alert('No se pudo actualizar el estado en el servidor: ' + errorTexto);
                }
            })
            .catch(() => {
                alert('Error de conexión al intentar guardar el cambio de estado.');
            });
        }

        // Control secuencial del timeline
        $('#tablaInventario').on('click', '.timeline-step', function() {
            const pasoDestino = $(this).data('paso');
            const indexDestino = parseInt($(this).data('index'), 10);
            const indexActual = parseInt($(this).data('actual'), 10);
            const idSubs = $(this).data('id-subs');
            const trabajador = $(this).data('trabajador');
            const dias = $(this).data('dias');
            const targetModalSelector = $(this).data('target-modal');

            // 1. Bloquear retroceso
            if (indexDestino < indexActual) {
                alert('No está permitido retroceder a un estado anterior.');
                return;
            }

            // 2. Bloquear si intenta saltar etapas
            if (indexDestino > indexActual + 1) {
                alert('Debe completar el paso anterior antes de avanzar a este estado.');
                return;
            }

            // 3. Si está en el mismo estado actual
            if (indexDestino === indexActual) {
                // Excepción en "En trámite" (índice 1): permitir abrir modal solo para registrar fecha de cobro posterior sin cambiar estado
                if (pasoDestino === 'en tramite') {
                    subsidioActivo = { idSubs, indexActual, esActualizacionEnTramite: true };
                    asignarIdSubsModales(idSubs);
                    configurarModalEnTramite(true);
                    if (modalEnTramiteEl) {
                        bootstrap.Modal.getOrCreateInstance(modalEnTramiteEl).show();
                    }
                    return;
                }

                alert('Este subsidio ya se encuentra en este estado.');
                return;
            }

            // 4. Avance válido al siguiente paso (indexDestino === indexActual + 1)
            subsidioActivo = { idSubs, indexActual, esActualizacionEnTramite: false };
            asignarIdSubsModales(idSubs);

            if (targetModalSelector === '#modalEnTramite') {
                configurarModalEnTramite(false);
            }

            const modalEl = document.querySelector(targetModalSelector);
            if (modalEl) {
                $(modalEl).find('.modal-body')
                    .attr('data-id-subs', idSubs)
                    .attr('data-trabajador', trabajador)
                    .attr('data-dias', dias);
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            } else {
                enviarActualizacionEstado(
                    idSubs,
                    pasoDestino,
                    `¿Desea avanzar el subsidio al estado "${pasoDestino.toUpperCase()}"?`
                );
            }
        });

        // Guardar modal En trámite (avanza a "en tramite" o actualiza fecha de cobro si ya estaba en "en tramite")
        $('#formEnTramite').on('submit', function(e) {
            e.preventDefault();
            const idSubs = $(this).find('.input-id-subs').val() || subsidioActivo.idSubs;
            const estadoDestino = 'en tramite';
            const fd = new FormData(this);
            fd.set('accion', 'guardar_en_tramite');
            fd.set('mantener_estado', subsidioActivo.esActualizacionEnTramite ? '1' : '0');
            enviarActualizacionEstado(idSubs, estadoDestino, null, fd);
        });

        // Excepción Observado -> NO: pasa directamente a "registro de pago"
        $('#btnObservadoNo').on('click', function() {
            const idSubs = $('#exampleModalToggle .input-id-subs').val() || subsidioActivo.idSubs;
            const fd = new FormData();
            fd.set('accion', 'observado_no');
            enviarActualizacionEstado(
                idSubs,
                'registro de pago',
                'Sin observación registrada. ¿Desea avanzar directamente a "REGISTRO DE PAGO"?',
                fd
            );
        });

        // Excepción Observado -> SÍ: subsanar y volver a "en tramite"
        $('#formSubsanarSubsidio').on('submit', function(e) {
            e.preventDefault();
            const idSubs = $(this).find('.input-id-subs').val() || subsidioActivo.idSubs;
            const fd = new FormData(this);
            fd.set('accion', 'subsanar_observado');
            fd.set('subsanado', '1');
            enviarActualizacionEstado(idSubs, 'en tramite', null, fd);
        });

        // Guardar modal Registro de pago -> pasa a "conciliacion"
        $('#formRegistroPago').on('submit', function(e) {
            e.preventDefault();
            const idSubs = $(this).find('.input-id-subs').val() || subsidioActivo.idSubs;
            const fd = new FormData(this);
            fd.set('accion', 'guardar_pago');
            enviarActualizacionEstado(idSubs, 'conciliacion', null, fd);
        });

        // Confirmar modal Conciliación -> finaliza / confirma conciliación
        $('#btnContinuarConciliacion').on('click', function() {
            const idSubs = $('#modalConciliacion .input-id-subs').val() || subsidioActivo.idSubs;
            const fd = new FormData();
            fd.set('accion', 'confirmar_conciliacion');
            enviarActualizacionEstado(
                idSubs,
                'conciliacion',
                '¿Confirmar que el depósito fue verificado y conciliado por Tesorería?',
                fd
            );
        });

        const clienteSelect = $('#cliente');
        const trabajadorSelect = $('#trabajador');

        clienteSelect.on('change', function() {
            var val = $(this).val();
            if (val !== "") { 
                trabajadorSelect.val("").prop('disabled', true); 
            } else { 
                trabajadorSelect.prop('disabled', false); 
            }
            table.column(1).search(val === "all" || val === "" ? "" : $("option:selected", this).text()).draw();
        });

        trabajadorSelect.on('change', function() {
            var val = $(this).val();
            if (val !== "") { 
                clienteSelect.val("").prop('disabled', true); 
            } else { 
                clienteSelect.prop('disabled', false); 
            }
            table.column(2).search(val === "" ? "" : $("option:selected", this).text()).draw();
        });

        $('#resetFiltro').on('click', function() {
            $('#filtroForm')[0].reset();
            clienteSelect.prop('disabled', false);
            trabajadorSelect.prop('disabled', false);
            table.search('').columns().search('').draw();
        });
    });
</script>
</body>
</html>
