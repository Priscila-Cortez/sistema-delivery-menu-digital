            http_response_code(400);
            echo json_encode(['ok' => false, 'msg' => $subida['msg']]);
            exit;
        }

        $fechaLimite = date('Y-m-d', strtotime("+{$diasSub} days"));
        $estadoRetorno = 'en tramite';
        actualizarEstadoSubsidioSiExiste($conn, $idSubs, $estadoRetorno);

        $guardado = guardarEnSubReporte($conn, $idSubs, $estadoRetorno, [
            'tiene_observacion'        => 'SI',
            'dias_subsanacion'         => $diasSub,
            'motivo_observacion'       => $motivo,
            'fecha_limite_subsanacion' => $fechaLimite,
            'archivo_observacion'      => $subida['ruta']
        ]);

        if ($guardado) {
            echo json_encode(['ok' => true, 'estado' => $estadoRetorno, 'fecha_limite' => $fechaLimite]);
        } else {
            http_response_code(500);
            echo json_encode(['ok' => false, 'msg' => 'Error al registrar subsanación: ' . $conn->error]);
        }
        break;

    case 'guardar_pago':
        $monto = isset($_POST['monto']) && $_POST['monto'] !== '' ? floatval($_POST['monto']) : null;
        if ($monto === null || $monto <= 0) {
            http_response_code(400);
            echo json_encode(['ok' => false, 'msg' => 'Ingresa un monto válido mayor a 0.']);
            exit;
        }

        $subida = guardarArchivoSubido('voucher', 'vouchers');
        if (!$subida['ok']) {
            http_response_code(400);
            echo json_encode(['ok' => false, 'msg' => $subida['msg']]);
            exit;
        }

        $estadoSiguiente = 'conciliacion';
        actualizarEstadoSubsidioSiExiste($conn, $idSubs, $estadoSiguiente);

        $guardado = guardarEnSubReporte($conn, $idSubs, $estadoSiguiente, [
            'monto_pagado'    => $monto,
            'archivo_voucher' => $subida['ruta']
        ]);

        if ($guardado) {
            echo json_encode(['ok' => true, 'estado' => $estadoSiguiente]);
        } else {
            http_response_code(500);
            echo json_encode(['ok' => false, 'msg' => 'Error al guardar pago en sub_reporte: ' . $conn->error]);
        }
        break;

    case 'confirmar_conciliacion':
        $estadoFinal = 'conciliacion';
        actualizarEstadoSubsidioSiExiste($conn, $idSubs, $estadoFinal);

        $guardado = guardarEnSubReporte($conn, $idSubs, $estadoFinal, [
            'confirmado_tesoreria' => 'SI'
        ]);

        if ($guardado) {
            echo json_encode(['ok' => true, 'estado' => $estadoFinal]);
        } else {
            http_response_code(500);
            echo json_encode(['ok' => false, 'msg' => 'Error al confirmar conciliación en sub_reporte: ' . $conn->error]);
        }
        break;

    case 'actualizar_estado':
    default:
        $nuevoEstado = strtolower(trim($_POST['nuevo_estado'] ?? ''));
        if (!in_array($nuevoEstado, $estadosValidos, true)) {
            http_response_code(400);
            echo json_encode(['ok' => false, 'msg' => 'Estado no válido.']);
            exit;
        }

        actualizarEstadoSubsidioSiExiste($conn, $idSubs, $nuevoEstado);
        $guardado = guardarEnSubReporte($conn, $idSubs, $nuevoEstado);

        if ($guardado) {
            echo json_encode(['ok' => true, 'estado' => $nuevoEstado]);
        } else {
            http_response_code(500);
            echo json_encode(['ok' => false, 'msg' => 'Error al actualizar estado en sub_reporte: ' . $conn->error]);
        }
        break;
