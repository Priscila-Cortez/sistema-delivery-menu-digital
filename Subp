            $motivoObservacion,
            $fechaLimiteSubsanacion,
            $archivoObservacion,
            $montoPagado,
            $archivoVoucher,
            $confirmadoTesoreria
        );
        $ok = $stmt->execute();
        $stmt->close();
        return $ok;
    }
}

$accion = trim($_POST['accion'] ?? 'actualizar_estado');
