                                                    </div>
                                                    <span class="label"><?= htmlspecialchars($etiquetas[$paso]) ?></span>
                                                </button>
                                            <?php endforeach; ?>
                                        </div>
                                    </td>
                                </tr>
                    <?php
                            }
                        } elseif (!$query_run) {
                            $errorSql = mysqli_error($conn);
                        }
                    } catch (Throwable $e) {
                        $errorSql = $e->getMessage();
                    }

                    if (!$tieneFilas) {
