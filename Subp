                                            Inicio: <code><?= htmlspecialchars($dni['fecha_inicio'] ?? '') ?></code><br>
                                            Fin: <code><?= htmlspecialchars($dni['fecha_fin'] ?? '') ?></code>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success-subtle text-secondary border border-secondary-subtle px-3 py-2 rounded-pill fw-bold">
                                            <?= htmlspecialchars($dni['total_dias'] ?? 0) ?> días
                                        </span>
                                    </td>
                                    <td>
                                        <div class="timeline-steps" data-id="<?= htmlspecialchars($dni['id_subs'] ?? '') ?>">
                                            <?php foreach ($pasos as $index => $paso): 
                                                $claseEstado = "";
                                                if ($index < $indiceActual) {
                                                    $claseEstado = "completed";
                                                } elseif ($index === $indiceActual) {
                                                    $claseEstado = "active";
                                                }
                                            ?>
                                                <button type="button"
                                                        class="timeline-step <?= $claseEstado ?>"
                                                        data-paso="<?= htmlspecialchars($paso) ?>"
                                                        data-index="<?= $index ?>"
                                                        data-actual="<?= $indiceActual ?>"
                                                        data-id-subs="<?= htmlspecialchars($dni['id_subs'] ?? '') ?>"
                                                        data-trabajador="<?= htmlspecialchars($dni['nombre_trabajador'] ?? '') ?>"
                                                        data-dias="<?= htmlspecialchars($dni['total_dias'] ?? 0) ?>"
                                                        data-target-modal="<?= $modales[$paso] ?>"
                                                        title="<?= htmlspecialchars($etiquetas[$paso]) ?>">
                                                    <div class="circle">
                                                        <?php if ($index < $indiceActual): ?>
                                                            <i class="bi bi-check-lg"></i>
                                                        <?php elseif ($index === $indiceActual): ?>
                                                            <i class="bi bi-dot"></i>
