        if ($guardado) {
            echo json_encode(['ok' => true, 'estado' => $nuevoEstado]);
        } else {
            http_response_code(500);
            echo json_encode(['ok' => false, 'msg' => 'Error al guardar en sub_reporte: ' . $conn->error]);
