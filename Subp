        break;

    case 'observado_no':
        $estadoDestino = 'registro de pago';
        actualizarEstadoSubsidioSiExiste($conn, $idSubs, $estadoDestino);

        $guardado = guardarEnSubReporte($conn, $idSubs, $estadoDestino, [
