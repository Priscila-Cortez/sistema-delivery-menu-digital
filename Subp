function columnaExiste(mysqli $conn, string $tabla, string $columna): bool
{
    $tablaEsc = $conn->real_escape_string($tabla);
    $colEsc = $conn->real_escape_string($columna);
    $res = $conn->query("SHOW COLUMNS FROM `{$tablaEsc}` LIKE '{$colEsc}'");
    return ($res && $res->num_rows > 0);
}

function guardarArchivoSubido(string $campoInput, string $subcarpeta): array
{
    if (!isset($_FILES[$campoInput]) || $_FILES[$campoInput]['error'] === UPLOAD_ERR_NO_FILE) {
        return ['ok' => true, 'ruta' => null];
    }

    if ($_FILES[$campoInput]['error'] !== UPLOAD_ERR_OK) {
        return ['ok' => false, 'msg' => 'Error al recibir el archivo adjunto.'];
    }

    $nombreOriginal = basename($_FILES[$campoInput]['name']);
    $extension = strtolower(pathinfo($nombreOriginal, PATHINFO_EXTENSION));
    $permitidas = ['pdf', 'jpg', 'jpeg', 'png', 'webp'];

    if (!in_array($extension, $permitidas, true)) {
        return ['ok' => false, 'msg' => 'Formato de archivo no permitido (usa PDF, JPG, JPEG, PNG o WEBP).'];
    }

    $dirBase = __DIR__ . '/../uploads/subsidios/' . trim($subcarpeta, '/');
    if (!is_dir($dirBase) && !mkdir($dirBase, 0775, true)) {
        return ['ok' => false, 'msg' => 'No se pudo crear el directorio de archivos.'];
    }

    $nombreUnico = 'sub_' . time() . '_' . bin2hex(random_bytes(4)) . '.' . $extension;
    $rutaFisica = $dirBase . '/' . $nombreUnico;

    if (!move_uploaded_file($_FILES[$campoInput]['tmp_name'], $rutaFisica)) {
        return ['ok' => false, 'msg' => 'No se pudo guardar el archivo en el servidor.'];
    }

    return ['ok' => true, 'ruta' => 'uploads/subsidios/' . trim($subcarpeta, '/') . '/' . $nombreUnico];
}

function actualizarEstadoSubsidioSiExiste(mysqli $conn, int $idSubs, string $estado): void
{
    if (!columnaExiste($conn, 'subsidios', 'estado')) {
        return;
    }
    $stmt = $conn->prepare("UPDATE subsidios SET estado = ? WHERE id_subs = ?");
    if ($stmt) {
        $stmt->bind_param("si", $estado, $idSubs);
        $stmt->execute();
        $stmt->close();
    }
}

function resolverClientePorEmpresa(mysqli $conn, string $empresa): string
{
    if (trim($empresa) === '') {
        return '';
    }
    $sql = "SELECT cli.cli_vcRazonSocial
            FROM cliente AS cli
            INNER JOIN contrato AS c ON c.cli_iId = cli.cli_iId
            INNER JOIN contrato_empresa AS cem ON cem.con_iId = c.con_iId
            INNER JOIN cliente AS cl ON cl.cli_iId = cem.cli_iId
            WHERE cl.cli_vcRazonSocial = ? OR cli.cli_vcRazonSocial = ?
            LIMIT 1";
    $stmt = $conn->prepare($sql);
    if (!$stmt) {
        return '';
    }
    $stmt->bind_param("ss", $empresa, $empresa);
    $stmt->execute();
    $stmt->bind_result($clienteResuelto);
    $encontrado = $stmt->fetch();
    $stmt->close();

    return $encontrado ? trim((string)$clienteResuelto) : '';
}

function guardarEnSubReporte(mysqli $conn, int $idSubs, string $estado, array $datosExtra = []): bool
{
    $tieneColClienteSubs = columnaExiste($conn, 'subsidios', 'cliente');
    $tieneColMontoDiarioSubs = columnaExiste($conn, 'subsidios', 'monto_diario');

    $sqlCliente = $tieneColClienteSubs ? "COALESCE(cliente, '')" : "''";
    $sqlMontoDiario = $tieneColMontoDiarioSubs ? "COALESCE(monto_diario, 0)" : "0";

    $sqlSub = "SELECT empresa, {$sqlCliente} AS cliente, nombre_trabajador, numdocumento, fecha_inicio, fecha_fin, {$sqlMontoDiario} AS monto_diario
               FROM subsidios
               WHERE id_subs = ?
               LIMIT 1";
    $stmtSub = $conn->prepare($sqlSub);
    if (!$stmtSub) {
        return false;
    }
    $stmtSub->bind_param("i", $idSubs);
    $stmtSub->execute();
    $stmtSub->bind_result($empresa, $cliente, $nombres, $dni, $fechaInicio, $fechaFin, $montoDiarioSubs);
    $encontrado = $stmtSub->fetch();
    $stmtSub->close();

    if (!$encontrado) {
        return false;
    }

    if (trim((string)$cliente) === '') {
        $cliente = resolverClientePorEmpresa($conn, (string)$empresa);
    }

    $totalDias = 0;
    if (!empty($fechaInicio) && !empty($fechaFin)) {
        $d1 = new DateTime($fechaInicio);
        $d2 = new DateTime($fechaFin);
        $totalDias = max(0, (int)$d1->diff($d2)->days + 1);
    }

    $montoPagado = $datosExtra['monto_pagado'] ?? null;
    $montoDiario = ((float)$montoDiarioSubs > 0) ? (float)$montoDiarioSubs : null;
    if ($montoDiario === null && $montoPagado !== null && $totalDias > 0) {
        $montoDiario = round((float)$montoPagado / $totalDias, 2);
    }

    $montoTotalEsperado = ($montoDiario !== null && $totalDias > 0)
        ? round($montoDiario * $totalDias, 2)
        : ($montoPagado !== null ? (float)$montoPagado : null);

    $fechaPresentacion = $datosExtra['fecha_presentacion'] ?? null;
    $nExpediente = $datosExtra['n_expediente'] ?? null;
    $fechaCobro = $datosExtra['fecha_cobro'] ?? null;
    $archivoExpediente = $datosExtra['archivo_expediente'] ?? null;

    $tieneObservacion = $datosExtra['tiene_observacion'] ?? null;
    $diasSubsanacion = $datosExtra['dias_subsanacion'] ?? null;
    $motivoObservacion = $datosExtra['motivo_observacion'] ?? null;
    $fechaLimiteSubsanacion = $datosExtra['fecha_limite_subsanacion'] ?? null;
    $archivoObservacion = $datosExtra['archivo_observacion'] ?? null;

    $archivoVoucher = $datosExtra['archivo_voucher'] ?? null;
