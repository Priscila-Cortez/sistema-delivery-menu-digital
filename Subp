                    <?php
                    $tieneColEstado = false;
                    $checkCol = @mysqli_query($conn, "SHOW COLUMNS FROM subsidios LIKE 'estado'");
                    if ($checkCol && mysqli_num_rows($checkCol) > 0) {
                        $tieneColEstado = true;
                    }

                    $selectEstado = $tieneColEstado ? "s.estado," : "";

                    $query = "SELECT 
                                    s.id_subs,
                                    COALESCE(MIN(rel.matriz), s.empresa) AS matriz,
                                    COALESCE(MIN(rel.cliente), s.cliente, '') AS cliente,
                                    s.nombre_trabajador,
                                    s.numdocumento,
                                    s.fecha_inicio,
                                    s.fecha_fin,
                                    {$selectEstado}
                                    totales.total_dias_trabajador AS total_dias
                              FROM subsidios s
                              LEFT JOIN (
                                  SELECT DISTINCT
                                      cl.cli_vcRazonSocial AS matriz,
                                      cli.cli_vcRazonSocial AS cliente
                                  FROM cliente AS cli
                                  INNER JOIN contrato AS c ON c.cli_iId = cli.cli_iId
                                  INNER JOIN contrato_empresa AS cem ON cem.con_iId = c.con_iId
                                  INNER JOIN cliente AS cl ON cl.cli_iId = cem.cli_iId
                              ) rel ON (rel.matriz = s.empresa OR rel.cliente = s.empresa OR rel.cliente = s.cliente)
                              INNER JOIN (
                                  SELECT 
                                      numdocumento,
                                      SUM(DATEDIFF(fecha_fin, fecha_inicio) + 1) AS total_dias_trabajador
                                  FROM subsidios
                                  GROUP BY numdocumento
                              ) totales ON s.numdocumento = totales.numdocumento
                              GROUP BY
                                  s.id_subs,
                                  s.empresa,
                                  s.cliente,
                                  s.nombre_trabajador,
                                  s.numdocumento,
                                  s.fecha_inicio,
                                  s.fecha_fin,
                                  " . ($tieneColEstado ? "s.estado," : "") . "
                                  totales.total_dias_trabajador
                              ORDER BY s.id_subs DESC";

                    $tieneFilas = false;
                    $errorSql = "";

                    try {
                        $query_run = mysqli_query($conn, $query);
