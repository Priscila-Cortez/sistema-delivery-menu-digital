                                    'en tramite' => '#modalEnTramite',
                                    'observado' => '#exampleModalToggle',
                                    'registro de pago' => '#modalRegistroPago',
                                    'conciliacion' => '#modalConciliacion'
                                ];

                                $indiceActual = array_search($estadoActual, $pasos);
                                if ($indiceActual === false) {
                                    $indiceActual = 0;
                                }
                    ?>
                                <tr>
                                    <td class="text-center text-secondary small"><?= htmlspecialchars($dni['matriz'] ?? '') ?></td>
                                    <td class="text-center text-secondary small"><?= htmlspecialchars($dni['cliente'] ?? '') ?></td>
                                    <td class="text-center text-secondary fw-bold small"><?= htmlspecialchars($dni['nombre_trabajador'] ?? '') ?></td>
